#!/bin/tdsh
# Native PCM playback.  Personality 5 is available on either socket, so the
# declaration has to name the socket the module is actually seated in.  PMOD1,
# next to the HDMI port, is the default: that is the arrangement the TinyNES
# release card ships, where the Wii Classic Controllers own PMOD0.  Set SOCKET=0
# for the OLED's former PMOD0 socket instead.  Declaring the other socket drives
# released pins and the Line Out stays silent.  OLED and encoder remain on hold.
#
#   tdsh run /scripts/i2s2-play.tdsh              # module seated in PMOD1
#   SOCKET=0; tdsh run /scripts/i2s2-play.tdsh    # module seated in PMOD0

CORE=/cores/console138k/phosphortang-i2s2-play.bin
if test -f "$CORE"
    echo "i2s2: playback image found"
else
    echo "i2s2: playback image missing"
    return 1
endif
tangload "$CORE"
if $? != 0
    echo "i2s2: FPGA load failed"
    return 1
endif
fpga
if $? != 0
    echo "i2s2: FPGA link unavailable"
    return 1
endif
if "$SOCKET" = "0"
    phosphor poke 0xc0 0x50
else
    phosphor poke 0xc0 0x500
endif
if $? != 0
    echo "i2s2: socket declaration failed"
    return 1
endif
osd off
phosphor peek 0xc0
phosphor peek 0xfc
echo "i2s2: ready for phosphor play /music/<track>"
echo "i2s2: HDMI and Line Out share native 44.1/48 kHz PCM"
return 0
