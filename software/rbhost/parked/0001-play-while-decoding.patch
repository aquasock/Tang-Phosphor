  * be compared with the same decode under qemu-riscv32.  stdout and stderr
  * go to the log ring.
  *
+ * In an image built with BENCH_PLAY=1 the output is also played as it is
+ * written: each PCM byte past the 0x2e-byte WAV header goes to the FPGA
+ * player while the codec is still decoding, so the first sample is heard
+ * after the codec's first frame rather than after the whole track.  The play
+ * stream's writes wait while it is full, which paces decoding to playback.
+ * Past OUTPUT_LIMIT the RAM copy stops (the CRC then reads 0) but playback
+ * does not.
+ *
  * Result registers:
  *   USER(0)      rbhost exit status
  *   USER(1,2)    core cycles of main(), low and high word
@@ -91,7 +99,58 @@ static struct {
 } files[MAX_FILES];
 
 static uint32_t output_size;
+static int output_overflow;
 static jmp_buf exit_context;
+
+/* Nonzero in an image built with BENCH_PLAY=1 (see play_bytes). */
+extern const uint32_t bench_play;
+
+/* Live playback of the output file.  The WAV header is the first 0x2e bytes
+ * and is never played; header fixups written by lseek at close land behind
+ * play_position and are ignored, so only the appended PCM is played. */
+#define WAV_HEADER_BYTES 0x2eu
+static uint32_t play_position;   /* output bytes already handed to the player */
+static int play_started;
+static int play_ended;
+
+static void play_start(void)
+{
+    const uint8_t *h = OUTPUT_BASE;
+    uint32_t rate = (uint32_t)h[0x18] | (uint32_t)h[0x19] << 8 |
+                    (uint32_t)h[0x1a] << 16 | (uint32_t)h[0x1b] << 24;
+    AE350_REG(AE350_PLAY_RATE) = rate;
+    AE350_REG(AE350_PLAY_CTRL) = 1u;
+    play_started = 1;
+}
+
+static void play_end(void)
+{
+    if (play_started && !play_ended) {
+        AE350_REG(AE350_PLAY_CTRL) = 2u;
+        play_ended = 1;
+    }
+}
+
+/* Hand the output bytes [position, position + count) to the player, playing
+ * only what extends the stream: PCM past the header, in order. */
+static void play_bytes(uint32_t position, const uint8_t *p, uint32_t count)
+{
+    uint32_t end = position + count;
+    uint32_t from = play_position > WAV_HEADER_BYTES ? play_position
+                                                     : WAV_HEADER_BYTES;
+    if (end <= from || position > from)
+        return;
+    p += from - position;
+    uint32_t n = end - from;
+    if (!play_started)
+        play_start();
+    for (; n >= 4; p += 4, n -= 4)
+        AE350_REG(AE350_PLAY_DATA) = (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+                                     (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+    for (; n; ++p, --n)
+        AE350_REG(AE350_PLAY_BYTE) = *p;
+    play_position = end;
+}
 static int exit_status;
 
