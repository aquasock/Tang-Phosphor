@@ -104,8 +163,11 @@ int _open(const char *path, int flags, int mode)
             files[fd].file = NULL;
             files[fd].position = 0;
             files[fd].open = 1;
-            if (flags & O_TRUNC)
+            if (flags & O_TRUNC) {
                 output_size = 0;
+                output_overflow = 0;
+                play_position = 0;
+            }
