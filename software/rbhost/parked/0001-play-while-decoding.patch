@@ -142,6 +204,8 @@ int _close(int fd)
 {
     if (!valid_fd(fd))
         return -1;
+    if (!files[fd].file)
+        play_end();
     files[fd].open = 0;
     return 0;
 }
@@ -171,11 +235,19 @@ int _write(int fd, const void *buffer, size_t count)
     if (!valid_fd(fd) || files[fd].file)
         return -1;
     uint32_t position = files[fd].position;
-    if (count > OUTPUT_LIMIT - position) {
-        errno = ENOSPC;
-        return -1;
+    if (count > OUTPUT_LIMIT - position || output_overflow) {
+        /* Playing, the RAM copy is only evidence and may stop; the header
+         * play_start reads is always inside the limit. */
+        if (!bench_play) {
+            errno = ENOSPC;
+            return -1;
+        }
+        output_overflow = 1;
+    } else {
+        memcpy(OUTPUT_BASE + position, buffer, count);
     }
-    memcpy(OUTPUT_BASE + position, buffer, count);
+    if (bench_play)
+        play_bytes(position, buffer, count);
     files[fd].position = position + count;
     if (files[fd].position > output_size)
         output_size = files[fd].position;
@@ -317,33 +389,6 @@ static uint32_t receive_stream_file(void)
 	}
 }
 
